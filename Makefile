# OpenRoot Master Makefile (Auto-generated by master pipeline)
.PHONY: all clean test verify build release

all: clean test verify build

clean:
	@echo "Cleaning temporary Python cache and staging artifacts..."
	@find . -type f -name "*.pyc" -delete
	@find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
	@rm -f *.log

test:
	@echo "Running local test suite and native pathway verification..."
	@if [ -f "bin/agent.sh" ]; then bash bin/agent.sh --test || true; fi
	@if [ -f "test_review_tool.py" ]; then python3 test_review_tool.py || true; fi

verify:
	@echo "Verifying workspace integrity and SQLite/FTS5 indexes..."
	@git status --short --branch

build:
	@echo "Compiling and packaging core OpenRoot binaries..."
	@mkdir -p workareas/release
	@echo "Build complete."

release: all
	@echo "Executing release bundling pipeline..."
