#!/usr/bin/env python3
"""Native OpenRoot local Ollama router; no cloud fallback."""
import argparse, datetime, hashlib, json, os, sys, time, urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BASE = "http://127.0.0.1:11434"

def request(endpoint, payload=None, timeout=10):
    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(
        BASE + endpoint, data=data,
        headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as response:
        return json.load(response)

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--prompt")
    p.add_argument("--local-only", action="store_true")
    p.add_argument("--model", default=os.environ.get("KAI_MODEL", ""))
    p.add_argument("--timeout", type=int, default=180)
    p.add_argument("--health", action="store_true")
    a = p.parse_args()
    if not a.health and not a.prompt:
        p.error("--prompt required unless --health")
    started = time.monotonic()
    receipt = {
        "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "endpoint": BASE, "cloud_fallback": False,
        "execution_status": "failed"
    }
    try:
        models = request("/api/tags").get("models", [])
        names = [m["name"] for m in models if m.get("name")]
        if not names:
            raise RuntimeError("Ollama reachable, but no installed models")
        if a.health:
            print(json.dumps({"ollama": "reachable",
                              "installed_models": names}, indent=2))
            return 0
        if a.model and a.model not in names:
            raise RuntimeError("Requested model is not installed: " + a.model)
        preference = [
            "qwen2.5-coder:0.5b", "qwen2.5-coder:1.5b",
            "qwen2.5:1.5b", "qwen3:0.6b",
            "qwen2.5-coder:7b", "qwen2.5:7b"
        ]
        model = a.model or next(
            (n for n in preference if n in names),
            min(models, key=lambda m: m.get("size", float("inf")))["name"]
        )
        receipt.update(
            model=model,
            prompt_sha256=hashlib.sha256(a.prompt.encode()).hexdigest()
        )
        result = request("/api/generate", {
            "model": model, "prompt": a.prompt, "stream": False,
            "think": False,
            "options": {"temperature": 0, "num_predict": 128}
        }, max(1, a.timeout))
        answer = result.get("response", "").strip()
        if result.get("done") is not True or not answer:
            raise RuntimeError("Generation incomplete or empty")
        receipt.update(
            execution_status="passed",
            response_chars=len(answer),
            response_sha256=hashlib.sha256(answer.encode()).hexdigest(),
            generation_done=True
        )
        print(answer)
        return 0
    except Exception as e:
        receipt["error"] = str(e)
        print("[kai] FAIL: " + str(e), file=sys.stderr)
        return 2
    finally:
        if not a.health:
            receipt["elapsed_seconds"] = round(time.monotonic()-started, 3)
            directory = ROOT / "workareas" / "router_checks"
            directory.mkdir(parents=True, exist_ok=True)
            name = datetime.datetime.now(datetime.timezone.utc).strftime(
                "kai_receipt_%Y%m%dT%H%M%S.%fZ.json")
            (directory / name).write_text(json.dumps(receipt, indent=2)+"\n")

if __name__ == "__main__":
    sys.exit(main())
