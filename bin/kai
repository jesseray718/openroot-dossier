#!/usr/bin/env python3
"""kai — local-only router for OpenRoot. Ollama first, no cloud fallback."""
import argparse, datetime, json, os, sys, urllib.error, urllib.request
from pathlib import Path
OLLAMA_URL = os.environ.get("OLLAMA_HOST_URL", "http://127.0.0.1:11434")
def ollama_request(endpoint, payload=None, timeout=120):
    if payload is None:
        req = urllib.request.Request(endpoint, method="GET")
    else:
        req = urllib.request.Request(endpoint, data=json.dumps(payload).encode(),
                                    headers={"Content-Type": "application/json"}, method="POST")
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.status, resp.read().decode("utf-8", errors="replace")
def pick_model(preferred, timeout=5):
    status, body = ollama_request(f"{OLLAMA_URL}/api/tags", None, timeout)
    names = [m.get("name", "") for m in json.loads(body).get("models", [])]
    if not names:
        raise RuntimeError("No Ollama models installed")
    if preferred and preferred in names:
        return preferred, names
    for n in sorted(names):
        if "qwen" in n.lower():
            return n, names
    return names[0], names
def main():
    p = argparse.ArgumentParser(prog="kai")
    p.add_argument("--prompt")
    p.add_argument("--local-only", action="store_true")
    p.add_argument("--model", default=os.environ.get("KAI_MODEL", ""))
    p.add_argument("--timeout", type=int, default=120)
    p.add_argument("--health", action="store_true")
    args = p.parse_args()
    root = Path(__file__).resolve().parent.parent
    checks = root / "workareas" / "router_checks"
    checks.mkdir(parents=True, exist_ok=True)
    ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    try:
        if args.health:
            status, body = ollama_request(f"{OLLAMA_URL}/api/tags", None, 5)
            names = [m.get("name", "") for m in json.loads(body).get("models", [])]
            print(f"[kai] Ollama reachable ({status}); models: {', '.join(names)}")
            return 0
        if not args.prompt:
            p.error("--prompt required unless --health")
        model, installed = pick_model(args.model, 5)
        print(f"[kai] Routing local model: {model} (local_only={args.local_only})")
        started = datetime.datetime.now(datetime.timezone.utc)
        status, body = ollama_request(f"{OLLAMA_URL}/api/generate",
            {"model": model, "prompt": args.prompt, "stream": False}, args.timeout)
        elapsed = (datetime.datetime.now(datetime.timezone.utc) - started).total_seconds()
        answer = json.loads(body).get("response", "").strip()
        print(answer if answer else "[kai] (empty)")
        receipt = {"timestamp": ts, "model": model,
                   "prompt_sha256": __import__("hashlib").sha256(args.prompt.encode()).hexdigest(),
                   "elapsed_seconds": round(elapsed, 2), "response_chars": len(answer),
                   "local_only": args.local_only, "installed_models": len(installed)}
        (checks / f"kai_receipt_{ts}.json").write_text(json.dumps(receipt, indent=2))
        return 0
    except (urllib.error.URLError, TimeoutError, ConnectionError, RuntimeError) as e:
        if args.local_only:
            print(f"[kai] FAIL local-only: {type(e).__name__}: {e}", file=sys.stderr)
            return 2
        print(f"[kai] Ollama unreachable ({type(e).__name__}); no cloud fallback.", file=sys.stderr)
        return 2
if __name__ == "__main__":
    sys.exit(main())
