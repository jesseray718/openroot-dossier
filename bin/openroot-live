#!/usr/bin/env python3
import shlex, subprocess, sys
args = sys.argv[1:]
if not args or args == ["status"]:
    forwarded = ["--health"]
elif args[0] == "ask" and len(args) > 1:
    forwarded = ["--local-only", "--prompt", " ".join(args[1:])]
else:
    raise SystemExit('Usage: openroot-live status | openroot-live ask "question"')
command = "/home/jesse/openroot/bin/kai " + shlex.join(forwarded)
try:
    result = subprocess.run(
        ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
         "jesse@100.122.169.43", command], timeout=210)
    sys.exit(result.returncode)
except subprocess.TimeoutExpired:
    raise SystemExit("FAIL: core request exceeded 210 seconds")
